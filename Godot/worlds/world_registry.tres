[gd_resource type="Resource" script_class="WorldRegistry" format=3]

[ext_resource type="Script" path="res://worlds/world_registry.gd" id="registry"]
[ext_resource type="Script" path="res://worlds/world_definition.gd" id="definition"]
[ext_resource type="PackedScene" path="res://worlds/floating_island/floating_island.tscn" id="island_scene"]
[ext_resource type="PackedScene" path="res://worlds/moon_garden/moon_garden.tscn" id="garden_scene"]
[ext_resource type="PackedScene" path="res://worlds/moonlit_grotto/moonlit_grotto.tscn" id="grotto_scene"]
[ext_resource type="PackedScene" path="res://worlds/starlight_observatory/observatory.tscn" id="observatory_scene"]
[ext_resource type="Texture2D" path="res://worlds/previews/floating_island.png" id="island_preview"]
[ext_resource type="Texture2D" path="res://worlds/previews/moon_garden.png" id="garden_preview"]
[ext_resource type="Texture2D" path="res://worlds/previews/moonlit_grotto.png" id="grotto_preview"]
[ext_resource type="Texture2D" path="res://worlds/previews/starlight_observatory.png" id="observatory_preview"]

[ext_resource type="PackedScene" path="res://worlds/prairie_crossing/prairie_crossing.tscn" id="prairie_scene"]
[ext_resource type="PackedScene" path="res://worlds/prairie_crossing/daylight.tscn" id="prairie_day_scene"]
[ext_resource type="PackedScene" path="res://worlds/prairie_crossing/night.tscn" id="prairie_night_scene"]
[ext_resource type="Texture2D" path="res://worlds/previews/prairie_crossing.png" id="prairie_preview"]
[ext_resource type="Texture2D" path="res://worlds/previews/prairie_daylight.png" id="prairie_day_preview"]
[ext_resource type="Texture2D" path="res://worlds/previews/prairie_night.png" id="prairie_night_preview"]

[sub_resource type="Resource" id="prairie"]
script = ExtResource("definition")
id = "prairie_crossing"
title = "Prairie Crossing · Rain"
description = "A quiet bench above the ravine, soft rainfall, wet trails, and misty pylons."
scene = ExtResource("prairie_scene")
preview = ExtResource("prairie_preview")

[sub_resource type="Resource" id="prairie_day"]
script = ExtResource("definition")
id = "prairie_daylight"
title = "Prairie Crossing · Daylight"
description = "A small fenced overlook among sage meadows, wooden benches, and prairie skies."
scene = ExtResource("prairie_day_scene")
preview = ExtResource("prairie_day_preview")

[sub_resource type="Resource" id="prairie_night"]
script = ExtResource("definition")
id = "prairie_night"
title = "Prairie Crossing · Night Lights"
description = "Blue-hour pylon silhouettes and warm city lights across the dark ravine."
scene = ExtResource("prairie_night_scene")
preview = ExtResource("prairie_night_preview")

[sub_resource type="Resource" id="island"]
script = ExtResource("definition")
id = "floating_island"
title = "Floating Island"
description = "Grassy island with trees."
scene = ExtResource("island_scene")
preview = ExtResource("island_preview")

[sub_resource type="Resource" id="garden"]
script = ExtResource("definition")
id = "moon_garden"
title = "Moon Garden"
description = "Open courtyard with trees and benches."
scene = ExtResource("garden_scene")
preview = ExtResource("garden_preview")

[sub_resource type="Resource" id="observatory"]
script = ExtResource("definition")
id = "starlight_observatory"
title = "Starlight Observatory"
description = "Moonlit alpine terrace with a brass observatory and interactive star globe."
scene = ExtResource("observatory_scene")
preview = ExtResource("observatory_preview")

[sub_resource type="Resource" id="grotto"]
script = ExtResource("definition")
id = "moonlit_grotto"
title = "Moonlit Grotto"
description = "Rocky island sanctuary with a waterfall, lagoon, quartz shrine, and glowcap mushrooms."
scene = ExtResource("grotto_scene")
preview = ExtResource("grotto_preview")

[resource]
script = ExtResource("registry")
worlds = Array[ExtResource("definition")]([SubResource("island"), SubResource("garden"), SubResource("grotto"), SubResource("observatory"), SubResource("prairie"), SubResource("prairie_day"), SubResource("prairie_night")])
